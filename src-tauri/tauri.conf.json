{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxDrop",
  "version": "0.1.0",
  "identifier": "com.fluxdrop.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FluxDrop",
        "width": 1100,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fluxdrop"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "webp", "gif"],
        "name": "Image",
        "description": "Send with FluxDrop",
        "role": "Viewer"
      },
      {
        "ext": ["mp4", "mov", "mkv", "webm"],
        "name": "Video",
        "description": "Send with FluxDrop",
        "role": "Viewer"
      },
      {
        "ext": ["pdf", "zip", "7z", "tar", "gz"],
        "name": "Document",
        "description": "Send with FluxDrop",
        "role": "Viewer"
      },
      {
        "ext": ["fluxdrop"],
        "name": "FluxDrop room link",
        "description": "Open a FluxDrop transfer room",
        "role": "Viewer"
      }
    ]
  }
}
