{
  "name": "FluxDrop — Peer-to-Peer File Transfer",
  "short_name": "FluxDrop",
  "description": "Send files directly between devices over WebRTC. No cloud, no servers, no storage. End-to-end encrypted.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0f0d",
  "theme_color": "#0d6e6e",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "screenshots": [
    {
      "src": "/screenshots/wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "FluxDrop on desktop — send files peer-to-peer"
    },
    {
      "src": "/screenshots/narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "FluxDrop on mobile — scan a QR and receive"
    },
    {
      "src": "/screenshots/wide-light.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "FluxDrop in light mode — a room with QR, PIN and queued files"
    },
    {
      "src": "/screenshots/narrow-light.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "FluxDrop in light mode — fast, private, peer-to-peer"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Send files",
      "short_name": "Send",
      "description": "Start a new outgoing transfer",
      "url": "/?action=send",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Receive files",
      "short_name": "Receive",
      "description": "Join a transfer room to receive files",
      "url": "/?action=receive",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  }
}
